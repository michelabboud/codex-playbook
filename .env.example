# HOME — required. User home containing `.agents/skills`.
# Inherited from the invoking shell; no project-level default.
# HOME=

# CODEX_HOME — optional. Codex configuration root and global `AGENTS.md` parent.
# Safe default when unset or empty: `$HOME/.codex`.
# Must be absolute, contain no `.` or `..` path components, and must not overlap
# a managed skill directory.
# CODEX_HOME=

# TMPDIR — optional. Temporary-file root used by verification and tests.
# Safe default when unset or empty: `/tmp`.
# TMPDIR=

# XDG_STATE_HOME — optional. Shared dashboard state base directory.
# Safe default when unset or empty: `$HOME/.local/state`.
# XDG_STATE_HOME=

# CODEX_THREAD_ID — optional. Harness session ID used by dashboard init.
# If absent, init generates a new identity; retain it for later posts.
# CODEX_THREAD_ID=

# WSL_DISTRO_NAME — optional, supplied by WSL when available.
# The browser opener also detects Microsoft in the kernel release.
# WSL_DISTRO_NAME=

# WSLENV — optional, inherited WSL interop variable export list.
# The opener preserves unrelated entries and adds its path only to the child.
# WSLENV=

# CODEX_BUILD_DASHBOARD_PATH — internal child-only translated Windows path.
# Set by the helper; do not configure it or put credentials in it.
# CODEX_BUILD_DASHBOARD_PATH=
